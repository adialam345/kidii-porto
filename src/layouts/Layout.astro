---
import '../styles/globals.css';
import { LoadingAnimation } from '../components/loading-animation';
import { SmoothScroll } from '../components/smooth-scroll';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Adi Alam | Portfolio", 
	description = "Personal portfolio website" 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-[#090a0f] text-white font-sans antialiased selection:bg-purple-500 selection:text-white relative overflow-x-hidden min-h-screen">
		{/* Ambient backdrop glow */}
		<div className="fixed inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))] pointer-events-none z-0"></div>
		<SmoothScroll client:load />
		<slot />
	</body>
</html>



